{
  "expo": {
    "name": "Vjez",
    "slug": "vjez",
    "scheme": "vjez",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-mobile.png",
      "resizeMode": "cover",
      "backgroundColor": "#A30019"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kavicki.vjez",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.kavicki.vjez",
      "adaptiveIcon": {
        "backgroundColor": "#A30019",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    }
  }
}
