{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "comentario": "supabase/functions roda em Deno, não no bundle do app: tem globais e imports próprios, e o tsc daqui não os conhece.",
  "exclude": ["node_modules", "supabase/functions", "dist", "publicar"]
}
